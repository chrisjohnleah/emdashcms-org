---
export const prerender = false;

import { env } from 'cloudflare:workers';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Button from '../../../../components/Button.astro';
import { isSuperAdmin } from '../../../../lib/auth/admin';
import { getAdminThemeDetail } from '../../../../lib/db/admin-queries';

const author = Astro.locals.author;
if (!author || !isSuperAdmin(author.githubId)) {
  return Astro.redirect('/dashboard', 302);
}

const themeId = Astro.params.id;
if (!themeId) return Astro.redirect('/dashboard/admin', 302);

const theme = await getAdminThemeDetail(env.DB, themeId);
if (!theme) return new Response('Theme not found', { status: 404 });

const formatDateTime = (iso: string) =>
  new Date(iso).toLocaleString('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });

const links = [
  { label: 'Preview', href: theme.previewUrl },
  { label: 'Demo', href: theme.demoUrl },
  { label: 'Repository', href: theme.repositoryUrl },
  { label: 'Homepage', href: theme.homepageUrl },
].filter((link): link is { label: string; href: string } => Boolean(link.href));
---
<BaseLayout title={`${theme.name} - Admin - emdashcms.org`}>
  <section class="page pt-12 pb-16 md:pt-16">

      <nav class="flex items-center gap-2 text-sm text-ink-soft mb-8">
        <a href="/dashboard/admin" class="hover:text-ink transition-colors">Admin</a>
        <span class="text-rule-strong">/</span>
        <span class="text-ink-soft">Themes</span>
        <span class="text-rule-strong">/</span>
        <span class="text-ink-muted">{theme.id}</span>
      </nav>

      <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6 mb-10">
        <div>
          <div class="flex items-center gap-3 flex-wrap">
            <h1 class="text-3xl text-ink">{theme.name}</h1>
            {theme.status === 'active' ? (
              <span class="inline-flex items-center rounded-full bg-success-soft border border-success/30 px-2.5 py-0.5 text-xs text-success font-medium">Active</span>
            ) : (
              <span class="inline-flex items-center rounded-full bg-danger-soft border border-danger/35 px-2.5 py-0.5 text-xs text-danger font-medium">Revoked</span>
            )}
          </div>
          <p class="mt-2 text-sm text-ink-soft font-mono">{theme.id}</p>
          {theme.shortDescription && (
            <p class="mt-3 max-w-2xl text-sm text-ink-muted leading-relaxed">{theme.shortDescription}</p>
          )}
        </div>

        <div class="flex items-center gap-2 shrink-0">
          {theme.status === 'active' && (
            <Button href={`/themes/${encodeURIComponent(theme.id)}`} variant="secondary" size="sm">Public page</Button>
          )}
          {theme.status === 'active' ? (
            <form method="POST" data-admin-theme-action="revoke" data-theme-id={theme.id}>
              <Button type="submit" variant="destructive" size="sm">Revoke theme</Button>
            </form>
          ) : (
            <form method="POST" data-admin-theme-action="restore" data-theme-id={theme.id}>
              <Button type="submit" variant="primary" size="sm">Restore theme</Button>
            </form>
          )}
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
          <section class="rounded-xl border border-rule bg-paper-soft p-6">
            <h2 class="text-lg text-ink mb-4">Listing</h2>
            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
              <div>
                <dt class="text-xs font-semibold text-ink-soft uppercase tracking-wide">Author</dt>
                <dd class="mt-1">
                  <a href={`/dashboard/admin/authors/${theme.authorId}`} class="text-ink hover:underline transition-colors">
                    {theme.authorUsername}
                  </a>
                </dd>
              </div>
              <div>
                <dt class="text-xs font-semibold text-ink-soft uppercase tracking-wide">GitHub ID</dt>
                <dd class="mt-1 text-ink-muted font-mono">{theme.authorGithubId}</dd>
              </div>
              <div>
                <dt class="text-xs font-semibold text-ink-soft uppercase tracking-wide">Category</dt>
                <dd class="mt-1 text-ink-muted">{theme.category ?? '--'}</dd>
              </div>
              <div>
                <dt class="text-xs font-semibold text-ink-soft uppercase tracking-wide">License</dt>
                <dd class="mt-1 text-ink-muted">{theme.license ?? '--'}</dd>
              </div>
              <div>
                <dt class="text-xs font-semibold text-ink-soft uppercase tracking-wide">Downloads</dt>
                <dd class="mt-1 text-ink-muted">{theme.downloadCount.toLocaleString()}</dd>
              </div>
              <div>
                <dt class="text-xs font-semibold text-ink-soft uppercase tracking-wide">Updated</dt>
                <dd class="mt-1 text-ink-muted">{formatDateTime(theme.updatedAt)}</dd>
              </div>
              <div class="sm:col-span-2">
                <dt class="text-xs font-semibold text-ink-soft uppercase tracking-wide">Created</dt>
                <dd class="mt-1 text-ink-muted">{formatDateTime(theme.createdAt)}</dd>
              </div>
              <div class="sm:col-span-2">
                <dt class="text-xs font-semibold text-ink-soft uppercase tracking-wide">Description</dt>
                <dd class="mt-1 text-ink-muted whitespace-pre-wrap leading-relaxed">{theme.description ?? '--'}</dd>
              </div>
              <div class="sm:col-span-2">
                <dt class="text-xs font-semibold text-ink-soft uppercase tracking-wide">Keywords</dt>
                <dd class="mt-2 flex flex-wrap gap-1.5">
                  {theme.keywords.length > 0 ? (
                    theme.keywords.map((kw) => (
                      <span class="rounded-full bg-paper-sunk border border-rule px-2 py-0.5 text-[11px] text-ink-muted">{kw}</span>
                    ))
                  ) : (
                    <span class="text-ink-muted">--</span>
                  )}
                </dd>
              </div>
            </dl>
          </section>

          <section class="rounded-xl border border-rule bg-paper-soft p-6">
            <h2 class="text-lg text-ink mb-4">Links</h2>
            {links.length === 0 ? (
              <p class="text-sm text-ink-muted">No public links set.</p>
            ) : (
              <dl class="space-y-3 text-sm">
                {links.map((link) => (
                  <div>
                    <dt class="text-xs font-semibold text-ink-soft uppercase tracking-wide">{link.label}</dt>
                    <dd class="mt-1">
                      <a href={link.href} target="_blank" rel="noopener noreferrer" class="text-ink-muted hover:text-ink underline underline-offset-4 break-all">
                        {link.href}
                      </a>
                    </dd>
                  </div>
                ))}
              </dl>
            )}
          </section>

          <section class="rounded-xl border border-rule bg-paper-soft p-6">
            <h2 class="text-lg text-ink mb-4">Screenshots</h2>
            {theme.screenshotKeys.length === 0 ? (
              <p class="text-sm text-ink-muted">No screenshots uploaded.</p>
            ) : (
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {theme.screenshotKeys.map((key, index) => (
                  <a href={`/api/v1/images/${key}`} target="_blank" rel="noopener noreferrer">
                    <img
                      src={`/api/v1/images/${key}`}
                      alt={`Screenshot ${index + 1} of ${theme.name}`}
                      class="aspect-video w-full rounded-md border border-rule object-cover"
                      loading="lazy"
                    />
                  </a>
                ))}
              </div>
            )}
          </section>
        </div>

        <aside class="space-y-6">
          <section class="rounded-xl border border-rule bg-paper-soft p-6">
            <h2 class="text-lg text-ink mb-4">Assets</h2>
            {theme.thumbnailKey ? (
              <div>
                <img
                  src={`/api/v1/images/${theme.thumbnailKey}`}
                  alt=""
                  class="aspect-[16/10] w-full rounded-md border border-rule object-cover"
                  loading="lazy"
                />
                <p class="mt-2 text-[11px] text-ink-soft font-mono break-all">{theme.thumbnailKey}</p>
              </div>
            ) : (
              <p class="text-sm text-ink-muted">No thumbnail uploaded.</p>
            )}
          </section>

          <section class="rounded-xl border border-rule bg-paper-soft p-6">
            <h2 class="text-lg text-ink mb-4">GitHub</h2>
            <dl class="space-y-3 text-sm">
              <div>
                <dt class="text-xs font-semibold text-ink-soft uppercase tracking-wide">Repository</dt>
                <dd class="mt-1 text-ink-muted break-all">{theme.githubRepoFullName ?? '--'}</dd>
              </div>
              <div>
                <dt class="text-xs font-semibold text-ink-soft uppercase tracking-wide">Auto-submit</dt>
                <dd class="mt-1 text-ink-muted">{theme.githubAutoSubmit === null ? '--' : theme.githubAutoSubmit ? 'Enabled' : 'Disabled'}</dd>
              </div>
              <div>
                <dt class="text-xs font-semibold text-ink-soft uppercase tracking-wide">Tag pattern</dt>
                <dd class="mt-1 text-ink-muted font-mono">{theme.githubTagPattern ?? '--'}</dd>
              </div>
            </dl>
          </section>
        </aside>
      </div>

  </section>

  <script>
    document.querySelectorAll('[data-admin-theme-action]').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const el = e.currentTarget as HTMLFormElement;
        const action = el.dataset.adminThemeAction;
        const themeId = el.dataset.themeId;
        if (!action || !themeId) return;
        if (action === 'revoke' && !confirm(`Revoke "${themeId}"? It will be hidden from public listings.`)) return;
        const res = await fetch(`/api/v1/admin/themes/${encodeURIComponent(themeId)}/${action}`, { method: 'POST' });
        if (res.ok) {
          window.location.reload();
        } else {
          const body = await res.json().catch(() => ({ error: 'Unknown error' })) as { error: string };
          alert(`Failed: ${body.error}`);
        }
      });
    });
  </script>
</BaseLayout>
