---
export const prerender = false;

import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicAuthors } from '../../lib/db/queries';
import { buildCollectionPageJsonLd, buildBreadcrumbListJsonLd } from '../../lib/seo/json-ld';

const authors = await getPublicAuthors(env.DB);

const title = 'EmDash Plugin & Theme Authors — emdashcms.org';
const description = 'Every author publishing EmDash CMS plugins and themes on the community marketplace, with their audited work and install counts.';

const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;

const jsonLd = [
  buildBreadcrumbListJsonLd([
    { name: 'Home', url: '/' },
    { name: 'Authors', url: '/authors' },
  ]),
  buildCollectionPageJsonLd({
    name: 'EmDash Plugin & Theme Authors',
    description,
    url: '/authors',
    items: authors.map((a) => ({ name: a.githubUsername, url: `/authors/${a.githubUsername}` })),
  }),
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} noindex={authors.length === 0}>
  <section class="page pt-12 pb-16 md:pt-16">
    <div class="page-narrow">
      <h1 class="text-3xl tracking-tight text-ink mb-3" style="font-weight: 500; letter-spacing: -0.02em;">
        Authors & Publishers
      </h1>
      <p class="text-lg text-ink-muted max-w-prose">
        Every plugin and theme on emdashcms.org is published by a GitHub-authenticated author.
        Each profile collects their audited work, install counts, and release history.
      </p>

      {authors.length === 0 ? (
        <p class="mt-10 text-ink-muted">No published authors yet. <a href="/docs/contributors" class="text-ink underline">Publish the first plugin →</a></p>
      ) : (
        <ul class="mt-10 grid gap-4 sm:grid-cols-2">
          {authors.map((a) => (
            <li>
              <a
                href={`/authors/${a.githubUsername}`}
                class="flex items-center gap-4 rounded-xl border border-rule bg-paper-soft p-5 hover:border-ink-soft transition-colors"
              >
                {a.avatarUrl ? (
                  <img src={a.avatarUrl} alt="" width="40" height="40" class="w-10 h-10 rounded-full" loading="lazy" />
                ) : (
                  <span class="w-10 h-10 rounded-full bg-rule" aria-hidden="true"></span>
                )}
                <span class="min-w-0">
                  <span class="block text-ink font-medium truncate">{a.githubUsername}</span>
                  <span class="block text-sm text-ink-muted">
                    {[
                      a.pluginCount > 0 && plural(a.pluginCount, 'plugin'),
                      a.themeCount > 0 && plural(a.themeCount, 'theme'),
                      a.installCount > 0 && plural(a.installCount, 'install'),
                    ].filter(Boolean).join(' · ')}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}

      <p class="mt-10 text-xs text-ink-soft">
        Banned or abusive accounts are hidden from public discovery.
        Want to be listed? <a href="/docs/contributors" class="underline">Read the contributor guide</a>.
      </p>
    </div>
  </section>
</BaseLayout>
