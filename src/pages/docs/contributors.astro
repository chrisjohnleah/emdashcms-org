---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import {
  buildBreadcrumbListJsonLd,
  buildFaqPageJsonLd,
  buildTechArticleJsonLd,
} from '../../lib/seo/json-ld';

const title = 'How to Publish a Plugin or Theme to EmDash CMS — Contributor Guide';
const description = 'Sign in with GitHub, upload a .tgz bundle, and pass the fail-closed security audit. Free contributor guide to publishing plugins and themes on the transparent, audited EmDash CMS community marketplace — no fees, full pipeline visibility.';

// TechArticle + BreadcrumbList for hierarchy, plus a FAQPage that
// answers the questions prospective contributors actually ask. The
// audit step is the most-asked: getting it surfaceable in AI answers
// reduces the "is this safe to publish to?" friction at first glance.
const contributorsJsonLd = [
  buildBreadcrumbListJsonLd([
    { name: 'Docs', url: '/docs/contributors' },
    { name: 'Contributor Guide', url: '/docs/contributors' },
  ]),
  buildTechArticleJsonLd({
    headline: 'How to Publish a Plugin or Theme to EmDash CMS',
    description,
    url: '/docs/contributors',
    datePublished: '2026-04-01',
    dateModified: '2026-05-30',
    author: { type: 'Organization', name: 'EmDash CMS Marketplace', url: 'https://emdashcms.org' },
    proficiencyLevel: 'Beginner',
  }),
  buildFaqPageJsonLd([
    {
      question: 'How do I publish a plugin to the EmDash CMS marketplace?',
      answer:
        'Sign in at /dashboard with your GitHub account, register a plugin id, then upload a .tgz bundle that contains a manifest.json at its root. The bundle goes through automated validation, static scanning, and an AI review before it goes live. You can optionally link a GitHub repository so tagged releases auto-publish.',
    },
    {
      question: 'What does the security audit check?',
      answer:
        'Three gates run on every uploaded version: bundle validation (size, paths, manifest schema), static scanning (pattern matching for dangerous primitives like eval, Function, dynamic imports, or undeclared network access), and an optional AI review for clean bundles. The pipeline is fail-closed: if any gate cannot produce a clean verdict, the version is rejected, never silently published.',
    },
    {
      question: 'What are the bundle size limits?',
      answer:
        'Each tarball must be at most 10 MB compressed and 50 MB decompressed, with no single file over 5 MB and no more than 200 files in total. No symlinks, hardlinks, or device files are allowed.',
    },
    {
      question: 'Is publishing to emdashcms.org free?',
      answer:
        'Yes. The marketplace is free to publish to and free to install from. There is no review fee, listing fee, or revenue share. The marketplace code, audit pipeline, and verdict logs are MIT-licensed on GitHub.',
    },
    {
      question: 'What is a manifest.json file?',
      answer:
        'manifest.json is a required file at the root of every plugin bundle. It declares the plugin id, version, capabilities, allowed hosts, hooks, routes, and storage. The runtime only grants access to what the manifest lists, so a plugin cannot silently read or modify anything outside its declared surface.',
    },
    {
      question: 'How long does the security audit take?',
      answer:
        'Bundle validation and the static scanner complete in seconds. AI review (when triggered on clean bundles) adds seconds to minutes. You see the full verdict and logs immediately in the dashboard.',
    },
    {
      question: 'What happens if my plugin is rejected by the audit?',
      answer:
        'You receive a detailed report with every blocking and soft finding. Fix the issues locally, then upload a corrected bundle. Static scanner results are deterministic: the same tarball always produces the same outcome.',
    },
    {
      question: 'Do I need to open source my plugin to publish it?',
      answer:
        'No. Only the manifest.json and marketplace metadata are public. Your source stays private unless you explicitly link a GitHub repository for the auto-publish flow.',
    },
    {
      question: 'How do I connect GitHub releases for automatic publishing?',
      answer:
        'From the dashboard, install the emdashcms.org GitHub App on the repo and link it to your registered plugin id. Every matching tagged release is downloaded, audited through the same pipeline, and published with provenance linking back to the GitHub release.',
    },
    {
      question: 'Is the audit pipeline and transparency data public?',
      answer:
        'Yes. The scanner rules, full marketplace code, and weekly aggregated audit metrics are open. View real pipeline throughput and outcomes at /transparency. Everything is MIT-licensed on GitHub.',
    },
    {
      question: 'How do published plugins appear in the catalog?',
      answer:
        'Once a version passes, it surfaces immediately in the /plugins and /themes browsing, search, and category pages. Site owners see the trust tier, declared capabilities, and full audit history on the detail page.',
    },
  ]),
];
---
<BaseLayout title={title} description={description} jsonLd={contributorsJsonLd}>
  <section class="page pt-12 pb-16 md:pt-16">
    <div class="page-narrow">

      <div class="mb-12">
        <h1 class="text-4xl md:text-5xl text-ink mb-4" style="font-weight: 500; letter-spacing: -0.02em;">
          Contributor Guide
        </h1>
        <p class="text-lg text-ink-muted leading-relaxed max-w-prose">
          Publish a plugin or theme for EmDash CMS. Every version passes our public fail-closed audit pipeline before it appears in the catalog. The full review process, scanner ruleset, and weekly metrics are transparent.
        </p>
        <p class="mt-3 text-sm">
          <a href="/plugins" class="text-ink underline hover:opacity-80">Browse the live catalog of audited plugins</a>
          <span class="text-ink-muted mx-1.5">·</span>
          <a href="/guide" class="text-ink underline hover:opacity-80">See the install-side guide</a>
          <span class="text-ink-muted mx-1.5">·</span>
          <a href="/dashboard" class="text-ink underline hover:opacity-80">Go to the publisher dashboard</a>
        </p>
      </div>

      <!-- Quick start -->
      <section class="mb-16">
        <h2 class="text-2xl text-ink mt-12 mb-4">Quick start</h2>
        <ol class="space-y-4 text-ink-muted leading-relaxed max-w-prose">
          <li class="flex gap-4">
            <span class="shrink-0 w-7 h-7 rounded-full bg-paper-soft border border-rule flex items-center justify-center text-xs font-mono text-ink-muted">1</span>
            <span>Sign in with GitHub at <a href="/dashboard" class="text-ink underline hover:opacity-80">/dashboard</a>. Your GitHub account is your marketplace identity.</span>
          </li>
          <li class="flex gap-4">
            <span class="shrink-0 w-7 h-7 rounded-full bg-paper-soft border border-rule flex items-center justify-center text-xs font-mono text-ink-muted">2</span>
            <span>Click "Register Plugin" (or "Register Theme"), fill out the metadata form, and upload a <code class="text-ink bg-paper-sunk px-1.5 py-0.5 rounded text-xs font-mono">.tgz</code> bundle.</span>
          </li>
          <li class="flex gap-4">
            <span class="shrink-0 w-7 h-7 rounded-full bg-paper-soft border border-rule flex items-center justify-center text-xs font-mono text-ink-muted">3</span>
            <span>Our static scanner reviews your bundle in seconds. If it passes, your plugin is published immediately with a "Scanned" trust tier. If the scanner flags soft findings, it's published as "Scanned — Caution". If blocking findings, it's rejected and you can see exactly why.</span>
          </li>
          <li class="flex gap-4">
            <span class="shrink-0 w-7 h-7 rounded-full bg-paper-soft border border-rule flex items-center justify-center text-xs font-mono text-ink-muted">4</span>
            <span>Iterate, upload new versions, and link a GitHub repo to auto-publish on tagged releases.</span>
          </li>
        </ol>
        <p class="mt-3 text-sm text-ink-muted max-w-prose">Approved versions surface in the <a href="/plugins" class="text-ink underline hover:opacity-80">public plugin catalog</a> and <a href="/compare" class="text-ink underline hover:opacity-80">marketplace comparisons</a>.</p>
      </section>

      <!-- manifest.json -->
      <section class="mb-16">
        <h2 class="text-2xl text-ink mt-12 mb-4">manifest.json schema</h2>
        <p class="text-ink-muted mb-4 max-w-prose">
          Every plugin bundle must contain a <code class="text-ink bg-paper-sunk px-1.5 py-0.5 rounded text-xs font-mono">manifest.json</code> at its root. The schema mirrors the EmDash CMS core contract so plugins work upstream too. For the complete field reference and audit-time validation rules, see the <a href="/learn/manifest-schema" class="text-ink underline hover:opacity-80">manifest schema documentation</a>.
        </p>
        <div class="rounded-lg border border-rule bg-paper-sunk p-4 font-mono text-xs text-ink overflow-x-auto whitespace-pre">{`{
  "id": "my-plugin",
  "version": "1.0.0",
  "capabilities": ["read:content", "network:fetch"],
  "allowedHosts": ["api.example.com"],
  "hooks": ["plugin:install", "content:beforeSave"],
  "routes": ["admin"],
  "storage": { "settings": {} },
  "admin": {
    "entry": "admin/index.js",
    "pages": [{ "path": "/my-plugin", "label": "My Plugin", "icon": "cog" }]
  }
}`}</div>

        <div class="mt-6 space-y-3 text-sm text-ink-muted max-w-prose">
          <p><strong class="text-ink font-medium">id</strong> — lowercase slug, alphanumeric + hyphens. Must match your registered plugin id.</p>
          <p><strong class="text-ink font-medium">version</strong> — strict semver (<code class="text-ink bg-paper-sunk px-1 rounded">X.Y.Z</code>). No pre-release suffixes in webhook submissions.</p>
          <p><strong class="text-ink font-medium">capabilities</strong> — from the fixed list of 11: <code class="text-ink bg-paper-sunk px-1 rounded">network:fetch</code>, <code class="text-ink bg-paper-sunk px-1 rounded">network:fetch:any</code>, <code class="text-ink bg-paper-sunk px-1 rounded">read:content</code>, <code class="text-ink bg-paper-sunk px-1 rounded">write:content</code>, <code class="text-ink bg-paper-sunk px-1 rounded">read:media</code>, <code class="text-ink bg-paper-sunk px-1 rounded">write:media</code>, <code class="text-ink bg-paper-sunk px-1 rounded">read:users</code>, <code class="text-ink bg-paper-sunk px-1 rounded">email:send</code>, <code class="text-ink bg-paper-sunk px-1 rounded">email:provide</code>, <code class="text-ink bg-paper-sunk px-1 rounded">email:intercept</code>, <code class="text-ink bg-paper-sunk px-1 rounded">page:inject</code>. Declare the minimum you need.</p>
          <p><strong class="text-ink font-medium">allowedHosts</strong> — every external domain your plugin calls. The scanner cross-checks this against every URL in your code.</p>
          <p><strong class="text-ink font-medium">hooks</strong> — only the 20 canonical EmDash hook names are accepted.</p>
        </div>
      </section>

      <!-- Bundle layout -->
      <section class="mb-16">
        <h2 class="text-2xl text-ink mt-12 mb-4">Bundle layout and limits</h2>
        <p class="text-ink-muted mb-4 max-w-prose">
          Your <code class="text-ink bg-paper-sunk px-1.5 py-0.5 rounded text-xs font-mono">.tgz</code> archive must contain:
        </p>
        <ul class="list-disc pl-6 space-y-1.5 text-sm text-ink-muted max-w-prose">
          <li><code class="text-ink bg-paper-sunk px-1 rounded">manifest.json</code> at the root.</li>
          <li>All source files (JavaScript/TypeScript, HTML, JSON) that your plugin needs at runtime.</li>
          <li>No symlinks, hardlinks, or device files. These are hard-rejected by the bundle validator.</li>
          <li>No path traversal or absolute paths.</li>
        </ul>
        <p class="text-ink-muted mt-4 mb-2 max-w-prose">Hard limits:</p>
        <ul class="list-disc pl-6 space-y-1.5 text-sm text-ink-muted max-w-prose">
          <li><strong class="text-ink">10 MB</strong> compressed tarball size.</li>
          <li><strong class="text-ink">50 MB</strong> decompressed total.</li>
          <li><strong class="text-ink">5 MB</strong> per individual file.</li>
          <li><strong class="text-ink">200</strong> files maximum.</li>
        </ul>
      </section>

      <!-- Review pipeline -->
      <section class="mb-16">
        <h2 class="text-2xl text-ink mt-12 mb-4">How review works</h2>
        <p class="text-ink-muted mb-4 max-w-prose">
          Every version goes through three gates. All three are automated — you do not wait on a human unless the scanner flags something ambiguous. The pipeline, ruleset, and outcomes are fully transparent.
        </p>
        <ol class="space-y-4 text-ink-muted max-w-prose">
          <li>
            <strong class="text-ink font-medium">1. Bundle validation.</strong>
            <p class="mt-1 text-sm text-ink-muted">Size limits, path safety, symlink rejection, manifest schema validation, checksum computation. Takes under a second.</p>
          </li>
          <li>
            <strong class="text-ink font-medium">2. Static scan.</strong>
            <p class="mt-1 text-sm text-ink-muted">
              Deterministic pattern matching for dangerous primitives and host declarations. Blocking findings (eval, new Function, child_process, process.binding, Worker-from-blob) reject the version. Soft findings (require, fs, undeclared hosts, browser-only APIs) publish with a "Caution" tier. Full ruleset at <a href="/docs/security" class="text-ink underline hover:opacity-80">/docs/security</a>.
            </p>
          </li>
          <li>
            <strong class="text-ink font-medium">3. AI review (when available).</strong>
            <p class="mt-1 text-sm text-ink-muted">
              Workers AI runs a second-pass review of clean bundles. Currently triggered by moderators on demand — as the marketplace scales this will move onto the upload hot path.
            </p>
          </li>
        </ol>
        <p class="mt-3 text-sm text-ink-muted max-w-prose">Weekly aggregated audit metrics and pipeline performance are published at <a href="/transparency" class="text-ink underline hover:opacity-80">/transparency</a>. Full developer resources at <a href="/developers" class="text-ink underline hover:opacity-80">/developers</a>.</p>
      </section>

      <!-- Trust tiers -->
      <section class="mb-16">
        <h2 class="text-2xl text-ink mt-12 mb-4">Trust tiers</h2>
        <p class="text-ink-muted mb-4 max-w-prose">Every published version carries a tier. Users see it on cards and detail pages in the <a href="/plugins" class="text-ink underline hover:opacity-80">public catalog</a>.</p>
        <div class="space-y-2 text-sm">
          <div class="rounded-lg border border-success/30 bg-success-soft p-3 text-success"><strong class="font-medium">Scanned</strong> — passed all static checks, no findings. Safe to install.</div>
          <div class="rounded-lg border border-success/30 bg-success-soft p-3 text-success"><strong class="font-medium">✦ AI-reviewed</strong> — scanned + AI audit both clean. Highest tier currently.</div>
          <div class="rounded-lg border border-warn/35 bg-warn-soft p-3 text-warn"><strong class="font-medium">Scanned — Caution</strong> — published with soft findings. Review the accordion before installing.</div>
          <div class="rounded-lg border border-warn/35 bg-warn-soft p-3 text-warn"><strong class="font-medium">✦ AI-reviewed — Caution</strong> — AI surfaced concerns worth knowing.</div>
          <div class="rounded-lg border border-danger/35 bg-danger-soft p-3 text-danger"><strong class="font-medium">Rejected / Revoked</strong> — not installable. Findings and admin notes visible on the detail page.</div>
        </div>
      </section>

      <!-- Common rejection reasons -->
      <section class="mb-16">
        <h2 class="text-2xl text-ink mt-12 mb-4">Common rejection reasons</h2>
        <ul class="list-disc pl-6 space-y-2 text-sm text-ink-muted max-w-prose">
          <li><strong class="text-ink">Use of eval() or new Function().</strong> Arbitrary code execution is a hard rejection. Refactor to use explicit imports.</li>
          <li><strong class="text-ink">child_process or process.binding.</strong> Node-only APIs — not available in the EmDash runtime. Remove any bundled Node-targeted code.</li>
          <li><strong class="text-ink">Undeclared hosts.</strong> If your code calls <code class="text-ink bg-paper-sunk px-1 rounded">fetch("https://x.com/...")</code>, <code class="text-ink bg-paper-sunk px-1 rounded">x.com</code> must be in <code class="text-ink bg-paper-sunk px-1 rounded">manifest.allowedHosts</code>.</li>
          <li><strong class="text-ink">Missing manifest.json.</strong> Every bundle needs one at the root, with a valid schema.</li>
          <li><strong class="text-ink">Manifest id mismatch.</strong> The id in <code class="text-ink bg-paper-sunk px-1 rounded">manifest.json</code> must match your registered plugin id.</li>
          <li><strong class="text-ink">Broad capabilities.</strong> <code class="text-ink bg-paper-sunk px-1 rounded">network:fetch:any</code>, <code class="text-ink bg-paper-sunk px-1 rounded">read:users</code>, and <code class="text-ink bg-paper-sunk px-1 rounded">email:intercept</code> add a caution signal — only declare them if your plugin genuinely needs them.</li>
        </ul>
      </section>

      <!-- GitHub auto-submit -->
      <section class="mb-16">
        <h2 class="text-2xl text-ink mt-12 mb-4">GitHub auto-submit</h2>
        <p class="text-ink-muted mb-4 max-w-prose">
          Instead of manually uploading bundles, install the emdashcms.org GitHub App on your repo and link it to your plugin from the dashboard. Every time you publish a GitHub Release whose tag matches your plugin's version, we'll download the tarball, scan it, and publish automatically. Webhook-sourced versions also capture a link back to the GitHub release page as build provenance.
        </p>
        <ul class="list-disc pl-6 space-y-1.5 text-sm text-ink-muted max-w-prose">
          <li>Tag pattern defaults to <code class="text-ink bg-paper-sunk px-1 rounded">*</code> — every release. Customise from the dashboard.</li>
          <li>Draft releases and pre-releases are ignored.</li>
          <li>The plugin id in the uploaded manifest must match your registered id.</li>
        </ul>
      </section>

      <!-- CLI publish -->
      <section class="mb-16" id="publish-from-the-cli">
        <h2 class="text-2xl text-ink mt-12 mb-4">Publish from the CLI</h2>
        <p class="text-ink-muted mb-4 max-w-prose">
          The upstream <code class="text-ink bg-paper-sunk px-1.5 py-0.5 rounded text-xs font-mono">emdash</code> CLI on npm can publish straight to this marketplace when you point it at <code class="text-ink bg-paper-sunk px-1.5 py-0.5 rounded text-xs font-mono">--registry https://emdashcms.org</code>. Authentication uses GitHub's device flow — the CLI prints a code, you authorise once in the browser, and credentials are cached locally.
        </p>
        <p class="text-ink-muted mb-4 max-w-prose">
          One-time login:
        </p>
        <pre class="text-sm bg-paper-sunk text-ink rounded-lg p-4 mb-4 overflow-x-auto"><code>npx emdash plugin login --registry https://emdashcms.org</code></pre>
        <p class="text-ink-muted mb-4 max-w-prose">
          Bundle and publish from your plugin directory:
        </p>
        <pre class="text-sm bg-paper-sunk text-ink rounded-lg p-4 mb-4 overflow-x-auto"><code>npx emdash plugin bundle
npx emdash plugin publish --registry https://emdashcms.org</code></pre>
        <ul class="list-disc pl-6 space-y-1.5 text-sm text-ink-muted max-w-prose">
          <li>Credentials are cached per registry — your emdashcms.org login is independent from any session you have with the upstream <code class="text-ink bg-paper-sunk px-1 rounded">marketplace.emdashcms.com</code>.</li>
          <li>The CLI hits the same audit pipeline as dashboard uploads and the GitHub auto-submit flow — no shortcuts.</li>
          <li>Same rate limits apply: 5 uploads/day per author, 10 audit runs/day.</li>
        </ul>
      </section>

      <!-- Version management -->
      <section class="mb-16">
        <h2 class="text-2xl text-ink mt-12 mb-4">Version management</h2>
        <ul class="list-disc pl-6 space-y-2 text-sm text-ink-muted max-w-prose">
          <li><strong class="text-ink">5 versions/day</strong> upload rate limit per author.</li>
          <li><strong class="text-ink">10 audit runs/day</strong> for AI-bound retries.</li>
          <li><strong class="text-ink">3 retries</strong> maximum per rejected version. After that, upload a new version with the fix.</li>
          <li><strong class="text-ink">Static-scanner rejections cannot be retried</strong> — the scan is deterministic, so the same bundle will always produce the same result. Upload a corrected bundle instead.</li>
          <li><strong class="text-ink">Revocation</strong> by an admin is reserved for cases where a published version needs to be blocked after the fact. Revoked versions are not downloadable and carry a public notice on the detail page.</li>
        </ul>
      </section>

      <!-- Community -->
      <section class="mb-16">
        <h2 class="text-2xl text-ink mt-12 mb-4">Community standards</h2>
        <p class="text-ink-muted mb-4 max-w-prose">
          By publishing here you agree to the
          <a href="/code-of-conduct" class="text-ink underline hover:opacity-80">Code of Conduct</a>,
          the
          <a href="/terms" class="text-ink underline hover:opacity-80">Terms of Use</a>, and the
          <a href="/docs/security" class="text-ink underline hover:opacity-80">security review policy</a>.
          Be kind, write clear descriptions, respond to support requests, and fix security issues promptly when reported.
        </p>
      </section>

      <!-- Next steps -->
      <section class="border-t border-rule pt-8 mt-12">
        <h3 class="text-sm font-semibold text-ink">Ready to publish?</h3>
        <div class="mt-4 flex flex-wrap gap-3">
          <Button href="/dashboard" variant="primary">
            Go to Dashboard
          </Button>
          <Button href="/docs/security" variant="secondary">
            Read the security policy
          </Button>
          <Button href="/plugins" variant="secondary">
            Browse the catalog
          </Button>
          <Button href="/transparency" variant="secondary">
            View audit transparency
          </Button>
        </div>
        <p class="mt-4 text-sm text-ink-muted max-w-prose">
          See <a href="/compare" class="text-ink underline hover:opacity-80">marketplace comparisons</a>, the <a href="/learn/manifest-schema" class="text-ink underline hover:opacity-80">full manifest reference</a>, or the <a href="/guide" class="text-ink underline hover:opacity-80">install guide</a>. Developer handbook at <a href="/developers" class="text-ink underline hover:opacity-80">/developers</a>.
        </p>
      </section>

    </div>
  </section>
</BaseLayout>
