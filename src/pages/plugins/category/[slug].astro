---
export const prerender = false;

import { env } from 'cloudflare:workers';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PluginCard from '../../../components/PluginCard.astro';
import EmptyState from '../../../components/EmptyState.astro';
import SearchBar from '../../../components/SearchBar.astro';
import Pagination from '../../../components/Pagination.astro';
import { searchPlugins, getPluginCategoryCounts, getPopularPluginsInCategory } from '../../../lib/db/queries';
import { buildBreadcrumbListJsonLd, buildCollectionPageJsonLd } from '../../../lib/seo/json-ld';

const { slug } = Astro.params;
const category = (slug ?? '').toLowerCase();

const url = new URL(Astro.request.url);
const query = url.searchParams.get('q') ?? '';
const cursor = url.searchParams.get('cursor');
const sort = url.searchParams.get('sort') ?? 'installs';
const LIMIT = 12;

const result = category
  ? await searchPlugins(env.DB, {
      query,
      category,
      capability: null,
      sort,
      cursor,
      limit: LIMIT,
    })
  : { items: [], nextCursor: null };

const [categoryCounts, popularInCategory] = await Promise.all([
  getPluginCategoryCounts(env.DB),
  category ? getPopularPluginsInCategory(env.DB, category, 4) : Promise.resolve([]),
]);

const thisCategoryCount = categoryCounts.find((c) => c.category === category)?.count ?? result.items.length;

const titleCategory = category
  .split('-')
  .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
  .join(' ');

const title = `${titleCategory} plugins - emdashcms.org`;
const description = `${thisCategoryCount} ${titleCategory} plugins for EmDash CMS. Audited, capability-declared extensions with public security reviews.`;

// Rich CollectionPage + Breadcrumb for pSEO (better than Breadcrumb-only).
const categoryJsonLd = [
  buildBreadcrumbListJsonLd([
    { name: 'Plugins', url: '/plugins' },
    { name: titleCategory, url: `/plugins/category/${category}` },
  ]),
  buildCollectionPageJsonLd({
    name: `${titleCategory} Plugins for EmDash CMS`,
    description: `${thisCategoryCount} audited ${titleCategory.toLowerCase()} plugins. Capability-declared, security-reviewed extensions for the EmDash ecosystem.`,
    url: `/plugins/category/${category}`,
    items: result.items.map((p) => ({
      name: p.name,
      url: `/plugins/${p.id}`,
    })),
  }),
];
---
<BaseLayout title={title} description={description} jsonLd={categoryJsonLd}>
  <section class="page pt-12 pb-16 md:pt-16">

      <nav class="flex items-center gap-2 text-sm text-ink-soft mb-6" aria-label="Breadcrumb">
        <a href="/plugins" class="hover:text-ink-muted transition-colors">Plugins</a>
        <span class="text-rule-strong">/</span>
        <span class="text-ink-muted">{titleCategory}</span>
      </nav>

      <h1 class="text-3xl tracking-tight leading-[1.15] text-ink" style="font-weight: 500; letter-spacing: -0.02em;">
        {titleCategory}
      </h1>
      <p class="mt-1 text-sm text-ink-muted">
        {thisCategoryCount} plugins in the {titleCategory.toLowerCase()} category. All published versions pass automated + AI security review.
      </p>
      <p class="mt-3 text-sm text-ink-muted max-w-prose">
        These plugins declare explicit capabilities and are scanned before they can be installed. 
        Browse the full list below or filter by capability in the main <a href="/plugins" class="text-ink underline">plugins hub</a>.
      </p>

      <div class="mt-6">
        <SearchBar
          action={`/plugins/category/${category}`}
          placeholder={`Search ${titleCategory.toLowerCase()} plugins...`}
          value={query}
        />
      </div>

      {popularInCategory.length > 0 && (
        <div class="mt-8">
          <h2 class="text-sm uppercase tracking-[0.18em] text-ink-soft mb-3">Popular in {titleCategory}</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            {popularInCategory.map((plugin) => (
              <PluginCard plugin={plugin} />
            ))}
          </div>
        </div>
      )}

      {result.items.length === 0 ? (
        <EmptyState
          heading="No plugins in this category yet"
          body="Be the first to publish one — or browse other categories."
          linkHref="/plugins"
          linkText="Browse all plugins"
        />
      ) : (
        <div class="mt-8">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {result.items.map((plugin) => (
              <PluginCard plugin={plugin} />
            ))}
          </div>
          <Pagination
            nextCursor={result.nextCursor}
            count={result.items.length}
            label="plugins"
            baseUrl={`/plugins/category/${category}`}
          />
        </div>
      )}

  </section>
</BaseLayout>
