---
export const prerender = false;

import { env } from 'cloudflare:workers';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ThemeCard from '../../../components/ThemeCard.astro';
import EmptyState from '../../../components/EmptyState.astro';
import SearchBar from '../../../components/SearchBar.astro';
import Pagination from '../../../components/Pagination.astro';
import { searchThemes } from '../../../lib/db/queries';
import { buildBreadcrumbListJsonLd, buildCollectionPageJsonLd } from '../../../lib/seo/json-ld';

const { slug } = Astro.params;
const category = (slug ?? '').toLowerCase();

const url = new URL(Astro.request.url);
const query = url.searchParams.get('q') ?? '';
const cursor = url.searchParams.get('cursor');
const sort = url.searchParams.get('sort') ?? 'created';
const LIMIT = 12;

const result = category
  ? await searchThemes(env.DB, {
      query,
      category,
      keyword: null,
      sort,
      cursor,
      limit: LIMIT,
    })
  : { items: [], nextCursor: null };

const titleCategory = category
  .split('-')
  .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
  .join(' ');

const title = `${titleCategory} themes - emdashcms.org`;
const description = `${result.items.length} ${titleCategory} themes for EmDash CMS. High-quality, installable themes with public metadata.`;

// Richer schema for pSEO.
const categoryJsonLd = [
  buildBreadcrumbListJsonLd([
    { name: 'Themes', url: '/themes' },
    { name: titleCategory, url: `/themes/category/${category}` },
  ]),
  buildCollectionPageJsonLd({
    name: `${titleCategory} Themes for EmDash CMS`,
    description,
    url: `/themes/category/${category}`,
    items: result.items.map((t) => ({
      name: t.name,
      url: `/themes/${t.id}`,
    })),
  }),
];
---
<BaseLayout title={title} description={description} jsonLd={categoryJsonLd}>
  <section class="page pt-12 pb-16 md:pt-16">

      <nav class="flex items-center gap-2 text-sm text-ink-soft mb-6" aria-label="Breadcrumb">
        <a href="/themes" class="hover:text-ink-muted transition-colors">Themes</a>
        <span class="text-rule-strong">/</span>
        <span class="text-ink-muted">{titleCategory}</span>
      </nav>

      <h1 class="text-3xl tracking-tight leading-[1.15] text-ink" style="font-weight: 500; letter-spacing: -0.02em;">
        {titleCategory}
      </h1>
      <p class="mt-1 text-sm text-ink-muted">
        Themes in the {titleCategory.toLowerCase()} category.
      </p>
      <p class="mt-3 text-sm text-ink-muted max-w-prose">
        These themes are ready to install via npm or repository. 
        See the full catalog in the <a href="/themes" class="text-ink underline">themes hub</a>.
      </p>

      <div class="mt-6">
        <SearchBar
          action={`/themes/category/${category}`}
          placeholder={`Search ${titleCategory.toLowerCase()} themes...`}
          value={query}
        />
      </div>

      {result.items.length === 0 ? (
        <EmptyState
          heading="No themes in this category yet"
          body="Be the first to publish one — or browse other categories."
          linkHref="/themes"
          linkText="Browse all themes"
        />
      ) : (
        <div class="mt-8">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {result.items.map((theme) => (
              <ThemeCard theme={theme} />
            ))}
          </div>
          <Pagination
            nextCursor={result.nextCursor}
            count={result.items.length}
            label="themes"
            baseUrl={`/themes/category/${category}`}
          />
        </div>
      )}

  </section>
</BaseLayout>
