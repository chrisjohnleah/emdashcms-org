---
export const prerender = false;

import { env } from 'cloudflare:workers';
import { getThemeDetail } from '../../lib/db/queries';
import { getReviewStats } from '../../lib/db/review-queries';
import { buildThemeJsonLd, buildBreadcrumbListJsonLd } from '../../lib/seo/json-ld';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Markdown from '../../components/Markdown.astro';

const { id } = Astro.params;
const theme = await getThemeDetail(env.DB, id!);

if (!theme) {
  Astro.response.status = 404;
}

// Structured data for AI and social discoverability. Fail-closed per
// CLAUDE.md: a malformed builder output must never 500 the page.
let themeJsonLd: object[] | undefined;
if (theme) {
  try {
    const themeReviewStats = await getReviewStats(env.DB, 'theme', id!);
    themeJsonLd = [
      buildThemeJsonLd(theme, themeReviewStats),
      buildBreadcrumbListJsonLd([
        { name: 'Themes', url: '/themes' },
        ...(theme.category
          ? [{
              name: theme.category.charAt(0).toUpperCase() + theme.category.slice(1),
              url: `/themes/category/${theme.category}`,
            }]
          : []),
        { name: theme.name, url: `/themes/${theme.id}` },
      ]),
    ];
  } catch (err) {
    console.error('[theme-detail] buildThemeJsonLd failed:', err);
    themeJsonLd = undefined;
  }
}

// OG image URL for social share previews. Points at /og/theme/[id].png
// — BaseLayout (Plan 01) consumes this via the `ogImage` prop and
// emits og:image + twitter:image meta, flipping twitter:card to
// `summary_large_image`.
const themeOgImage: { url: string; width: number; height: number } | undefined =
  theme
    ? {
        url: `https://emdashcms.org/og/theme/${theme.id}.png`,
        width: 1200,
        height: 630,
      }
    : undefined;

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const liveDemoUrl = theme ? (theme.demoUrl ?? theme.previewUrl) : null;

// Themes are Astro starters; `create astro --template owner/repo` works
// for any plain GitHub repo. Other hosts get no command rather than a
// guessed one.
const ghRepo = theme?.repositoryUrl?.match(/^https:\/\/github\.com\/([\w.-]+\/[\w.-]+?)(?:\.git)?\/?$/)?.[1];
const createCommand = ghRepo ? `npm create astro@latest -- --template ${ghRepo}` : null;
---
{!theme ? (
  <BaseLayout title="Theme not found - emdashcms.org">
    <section class="page pt-12 pb-16 md:pt-16">
      <div class="text-center py-16">
        <h1 class="text-xl text-ink" style="font-weight: 500; letter-spacing: -0.02em;">Theme not found</h1>
        <p class="mt-2 text-sm text-ink-muted">The theme you're looking for doesn't exist or may have been removed.</p>
        <div class="mt-6 inline-flex">
          <Button href="/themes" variant="primary">Browse Themes</Button>
        </div>
      </div>
    </section>
  </BaseLayout>
) : (
  <BaseLayout
    title={theme.name + " — EmDash CMS Theme | emdashcms.org"}
    description={theme.shortDescription ?? theme.description ?? undefined}
    jsonLd={themeJsonLd}
    ogImage={themeOgImage}
  >
    <section class="page pt-12 pb-16 md:pt-16">

      <a href="/themes" class="text-sm text-ink-muted hover:text-ink transition-colors inline-flex items-center gap-1.5">
        <span aria-hidden="true">←</span> Back to themes
      </a>

      <div class="mt-10 lg:grid lg:grid-cols-12 lg:gap-12">

        <div class="lg:col-span-8">
          <header>
            <h1 class="font-display text-4xl md:text-5xl text-ink leading-[1.05] tracking-tight" style="font-weight: 500;">
              {theme.name}
            </h1>
            {theme.shortDescription && (
              <p class="mt-4 text-lg text-ink-muted leading-relaxed max-w-2xl">{theme.shortDescription}</p>
            )}
            <div class="mt-5 flex items-center gap-2 flex-wrap text-sm text-ink-soft">
              {theme.author.avatarUrl ? (
                <img src={theme.author.avatarUrl} alt="" class="w-5 h-5 rounded-full" />
              ) : (
                <span class="w-5 h-5 rounded-full bg-paper-deep" aria-hidden="true"></span>
              )}
              <a href={`/authors/${theme.author.name}`} class="text-ink-muted hover:text-ink transition-colors">{theme.author.name}</a>
              <span class="emdash-sep" aria-hidden="true"></span>
              <span title="Outbound clicks to the demo, repository, or homepage">{theme.downloadCount.toLocaleString()} {theme.downloadCount === 1 ? 'download' : 'downloads'}</span>
              <span class="emdash-sep" aria-hidden="true"></span>
              <span>Updated {formatDate(theme.updatedAt)}</span>
            </div>
          </header>

          <div class="mt-8 flex items-center gap-3 flex-wrap">
            {liveDemoUrl && (
              <Button href={liveDemoUrl} target="_blank" rel="noopener noreferrer" variant="primary" size="lg" data-track-theme-download>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
                Live demo
              </Button>
            )}
            {theme.repositoryUrl && (
              <Button href={theme.repositoryUrl} target="_blank" rel="noopener noreferrer" variant="secondary" size="lg" data-track-theme-download>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" /></svg>
                View source
              </Button>
            )}
          </div>

          {theme.screenshotUrls.length > 0 && (
            <div class="mt-10">
              <h2 class="sr-only">Screenshots</h2>
              <a href={theme.screenshotUrls[0]} data-lightbox="0" class="block rounded-lg border border-rule overflow-hidden bg-paper-sunk cursor-zoom-in">
                <img src={theme.screenshotUrls[0]} alt={`${theme.name} screenshot 1`} class="w-full aspect-[16/10] object-cover object-top" width="1920" height="1200" />
              </a>
              {theme.screenshotUrls.length > 1 && (
                <ul class="mt-3 grid grid-cols-3 sm:grid-cols-4 gap-3">
                  {theme.screenshotUrls.slice(1).map((url, i) => (
                    <li>
                      <a href={url} data-lightbox={String(i + 1)} class="block rounded-md border border-rule overflow-hidden bg-paper-sunk cursor-zoom-in hover:border-ink transition-colors">
                        <img src={url} alt={`${theme.name} screenshot ${i + 2}`} loading="lazy" class="w-full aspect-[16/10] object-cover object-top" width="480" height="300" />
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          )}

          {theme.description && (
            <div class="mt-12">
              <h2 class="font-display text-2xl text-ink" style="font-weight: 500;">About this theme</h2>
              <Markdown source={theme.description} class="mt-3 max-w-prose text-base text-ink-muted leading-relaxed" />
            </div>
          )}
        </div>

        <aside class="mt-12 lg:mt-0 lg:col-span-4 space-y-6">
          <div class="rounded-md border border-rule bg-paper-soft p-6">
            <h2 class="font-display text-lg text-ink" style="font-weight: 500;">Start a site with this theme</h2>
            {createCommand ? (
              <>
                <p class="mt-2 text-sm text-ink-muted leading-relaxed">Themes are Astro starter projects. This scaffolds a new EmDash site from the theme's repository.</p>
                <div class="mt-4 flex items-center gap-2 rounded-md border border-rule bg-paper p-3">
                  <code class="flex-1 min-w-0 font-mono text-xs text-ink-muted whitespace-nowrap overflow-x-auto leading-relaxed py-1">{createCommand}</code>
                  <button type="button" data-copy={createCommand} class="flex-shrink-0 rounded border border-rule-strong bg-paper-soft px-3 py-1 text-xs font-medium text-ink hover:bg-paper-sunk transition-colors cursor-pointer" aria-label="Copy install command">Copy</button>
                </div>
              </>
            ) : (
              <p class="mt-2 text-sm text-ink-muted leading-relaxed">Follow the setup steps in the theme's repository or homepage.</p>
            )}
            <a href="/guide" class="mt-4 inline-flex items-center gap-1.5 text-xs text-ink-soft hover:text-ink transition-colors">How to install themes →</a>
          </div>

          <dl class="rounded-md border border-rule bg-paper-soft p-6 space-y-5">
            {theme.category && (
              <div>
                <dt class="text-[11px] font-semibold text-ink-soft uppercase tracking-wider">Category</dt>
                <dd class="mt-1.5 text-sm"><a href={`/themes/category/${theme.category}`} class="text-ink hover:text-accent-deep underline underline-offset-2 decoration-rule-strong hover:decoration-accent-deep capitalize">{theme.category}</a></dd>
              </div>
            )}
            {theme.license && (
              <div>
                <dt class="text-[11px] font-semibold text-ink-soft uppercase tracking-wider">Licence</dt>
                <dd class="mt-1.5 text-sm text-ink-muted">{theme.license}</dd>
              </div>
            )}
            {[
              ['Demo', liveDemoUrl],
              ['Repository', theme.repositoryUrl],
              ['Homepage', theme.homepageUrl !== theme.repositoryUrl ? theme.homepageUrl : null],
            ].filter(([, url]) => url).map(([label, url]) => (
              <div>
                <dt class="text-[11px] font-semibold text-ink-soft uppercase tracking-wider">{label}</dt>
                <dd class="mt-1.5"><a href={url!} target="_blank" rel="noopener noreferrer" data-track-theme-download class="text-sm text-ink hover:text-accent-deep transition-colors break-all underline underline-offset-2 decoration-rule-strong hover:decoration-accent-deep">{url!.replace(/^https?:\/\//, '')}</a></dd>
              </div>
            ))}
            {theme.keywords.length > 0 && (
              <div>
                <dt class="text-[11px] font-semibold text-ink-soft uppercase tracking-wider">Keywords</dt>
                <dd class="mt-1.5 flex flex-wrap gap-1.5">
                  {theme.keywords.map(kw => (
                    <a href={`/themes?keyword=${encodeURIComponent(kw)}`} class="rounded-full bg-paper-sunk border border-rule px-2 py-0.5 text-[11px] text-ink-muted hover:text-ink hover:border-ink transition-colors">{kw}</a>
                  ))}
                </dd>
              </div>
            )}
          </dl>

          <a href={`/report/theme/${theme.id}`} class="inline-flex items-center gap-1.5 text-xs text-ink-soft hover:text-ink transition-colors">Report a problem with this theme →</a>
        </aside>
      </div>
    </section>

    {theme.screenshotUrls.length > 0 && (
      <dialog id="theme-lightbox" class="m-auto max-w-[min(96vw,1600px)] bg-transparent p-0 backdrop:bg-ink/85" aria-label={`${theme.name} screenshots`}>
        <form method="dialog" class="flex justify-end gap-2 mb-2">
          {theme.screenshotUrls.length > 1 && (
            <>
              <button type="button" data-lightbox-step="-1" class="rounded bg-paper/90 px-3 py-1.5 text-sm text-ink cursor-pointer" aria-label="Previous screenshot">←</button>
              <button type="button" data-lightbox-step="1" class="rounded bg-paper/90 px-3 py-1.5 text-sm text-ink cursor-pointer" aria-label="Next screenshot">→</button>
            </>
          )}
          <button class="rounded bg-paper/90 px-3 py-1.5 text-sm text-ink cursor-pointer" aria-label="Close">Close</button>
        </form>
        <img id="theme-lightbox-img" src="" alt="" class="block max-h-[85vh] w-auto rounded-md" />
      </dialog>
    )}

    <script is:inline define:vars={{ shots: theme.screenshotUrls, themeName: theme.name }}>
      (function () {
      document.querySelectorAll("[data-copy]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          navigator.clipboard.writeText(btn.getAttribute("data-copy")).then(function () {
            btn.textContent = "Copied!";
            setTimeout(function () { btn.textContent = "Copy"; }, 2000);
          });
        });
      });
      })();
      (function () {
        var dlg = document.getElementById("theme-lightbox");
        var img = document.getElementById("theme-lightbox-img");
        if (!dlg || !img || !dlg.showModal) return;
        var current = 0;
        function show(i) {
          current = (i + shots.length) % shots.length;
          img.src = shots[current];
          img.alt = themeName + " screenshot " + (current + 1);
        }
        document.querySelectorAll("[data-lightbox]").forEach(function (a) {
          a.addEventListener("click", function (e) {
            e.preventDefault();
            show(Number(a.getAttribute("data-lightbox")));
            dlg.showModal();
          });
        });
        dlg.querySelectorAll("[data-lightbox-step]").forEach(function (b) {
          b.addEventListener("click", function () { show(current + Number(b.getAttribute("data-lightbox-step"))); });
        });
        dlg.addEventListener("keydown", function (e) {
          if (e.key === "ArrowRight") show(current + 1);
          if (e.key === "ArrowLeft") show(current - 1);
        });
        dlg.addEventListener("click", function (e) { if (e.target === dlg) dlg.close(); });
      })();
    </script>

    <script is:inline define:vars={{ themeId: theme.id }}>
      // Track outbound install-intent clicks. Themes have no bundle in
      // our R2, so an outbound click is the only "interest" signal we
      // can capture. We use sendBeacon so the request is fire-and-forget
      // and survives the page navigation; if the browser lacks beacon
      // support we fall back to a keepalive fetch.
      (function () {
        var sent = false;
        function track() {
          if (sent) return;
          sent = true;
          var url = "/api/v1/themes/" + encodeURIComponent(themeId) + "/downloads";
          try {
            if (navigator.sendBeacon) {
              navigator.sendBeacon(url);
            } else {
              fetch(url, { method: "POST", keepalive: true }).catch(function () {});
            }
          } catch (e) {
            // Tracking failures must never break navigation.
          }
        }
        document
          .querySelectorAll("[data-track-theme-download]")
          .forEach(function (el) {
            el.addEventListener("click", track);
            // auxclick covers middle-click "open in new tab"
            el.addEventListener("auxclick", track);
          });
      })();
    </script>
  </BaseLayout>
)}
